{
  "name": "opencode-observer",
  "version": "0.1.0",
  "description": "Observability plugin for OpenCode",
  "keywords": [
    "observability",
    "opencode",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slipfre/opencode-observer.git"
  },
  "files": [
    "dist",
    "!dist/standalone"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run build:package && bun run build:standalone",
    "build:package": "bun build ./src/index.ts --outdir=./dist --target=bun --format=esm --packages=external --sourcemap=linked && tsc -p tsconfig.build.json",
    "build:standalone": "bun build ./src/index.ts --outfile=./dist/standalone/opencode-observer.js --target=bun --format=esm --packages=bundle",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests",
    "test:e2e": "bun run build && bun test ./e2e --timeout 60000",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "prepack": "bun run check && bun run test && bun run build"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@opencode-ai/plugin": "^1.18.30",
    "@opencode-ai/sdk": "^1.18.30",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "ai": "6.0.168"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "protobufjs": "^7.6.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "oc-plugin": [
    "server"
  ]
}
